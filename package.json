{
  "name": "sites",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.80",
      "@astrojs/check": "0.9.10",
      "@astrojs/cloudflare": "14.3.3",
      "@astrojs/react": "6.0.6",
      "@base-ui/react": "1.8.0",
      "@cloudflare/workers-types": "5.20261005.1",
      "@effect/platform-bun": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@effect/vitest": "4.0.0",
      "@eisbachcode/emdash-plugin-analytics": "0.3.1",
      "@emdash-cms/cloudflare": "1.1.0",
      "@emnapi/core": "1.11.3",
      "@emnapi/runtime": "1.11.3",
      "@lucide/astro": "1.52.0",
      "@tailwindcss/vite": "4.3.3",
      "@types/bun": "1.3.14",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "alchemy": "2.0.0-beta.80",
      "astro": "7.3.5",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.0",
      "emdash": "1.1.0",
      "lucide-react": "1.52.0",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "tailwind-merge": "3.7.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "6.0.3",
      "vitest": "5.0.3",
      "wrangler": "4.147.0",
      "@emdash-cms/auth": "1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "bun run sync && ultracite check --max-warnings 0",
    "fix": "bun run sync && ultracite fix",
    "lint:ci": "bun run sync && ultracite check --max-warnings 0 --format github",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "test": "turbo run test //#test:root",
    "verify": "bun run ci && bun run build",
    "typecheck:root": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p stacks/turbo-cache/tsconfig.json",
    "test:root": "vitest run",
    "smoke": "bun packages/control-app/src/cli.ts smoke",
    "references": "bun scripts/sync-references.ts",
    "setup:worktree": "bun scripts/setup-worktree.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "app": "bun packages/control-app/src/cli.ts",
    "dev": "bun packages/control-app/src/cli.ts dev",
    "ci": "bun run check && turbo run typecheck test //#typecheck:root //#test:root",
    "proof": "bun packages/proof/src/cli.ts",
    "sync": "turbo run sync --output-logs=errors-only"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@jakebodea/cloudflare-kit": "workspace:*",
    "@jakebodea/config": "workspace:*",
    "@jakebodea/control-app": "workspace:*",
    "@jakebodea/proof": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@shadcn/lint": "0.2.0",
    "@types/bun": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.1.17",
    "miniflare": "5.20261001.0-alpha",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-react-doctor": "0.9.17",
    "oxlint-tsgolint": "7.0.2003",
    "p-limit": "7.3.3",
    "playwright-core": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9"
}
