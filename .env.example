# Copy to `.env` in the MAIN checkout only (worktrees get a symlink via scripts/setup-worktree.ts).
# Never put Cloudflare credentials here: use `alchemy profile` (and ALCHEMY_PROFILE in your shell).
# Deployed stages get these from GitHub environment secrets in CI (see stacks/github.ts).

# PostHog (public ingestion key; analytics stays off when empty)
POSTHOG_PROJECT_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Email Service sender (a verified domain); mail is logged, not sent, when empty
EMAIL_FROM=
LEAD_NOTIFY_TO=

# Turborepo remote cache (stacks/turbo-cache.ts)
TURBO_API=
TURBO_TEAM=
TURBO_TOKEN=
