---
/**
 * Page shell: EmDash head/body hooks (SEO tags, hreflang for translated
 * entries, plugin contributions, visual editing), fonts, header/footer from
 * the locale's CMS menus, structured data, the application dialog, and
 * analytics when enabled. Pages pass SEO from `getSeoMeta()`.
 */
import "@/styles/global.css";

import { env } from "cloudflare:workers";
import { Font } from "astro:assets";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { breadcrumbJsonLd, documentTitle, metaDescription } from "@jakebodea/cloudflare-kit/seo";
import type { Crumb } from "@jakebodea/cloudflare-kit/seo";

import WebAnalyticsBeacon from "@jakebodea/cloudflare-kit/astro/web-analytics-beacon.astro";
import ApplyDialog from "@/components/islands/apply-dialog";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import StructuredData from "@/components/structured-data.astro";
import { LANGUAGE_TAG, toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { getSiteChrome } from "@/lib/content";
import type { Alternates } from "@/lib/content";
import { site } from "../../site.config";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string | undefined;
  description?: string | null | undefined;
  image?: string | null | undefined;
  canonical?: string | null | undefined;
  robots?: string | null | undefined;
  content?: { collection: string; id: string; slug?: string | null } | undefined;
  /** The same page in other languages, for the visible switcher. */
  alternates?: Alternates | undefined;
  /** Breadcrumb trail (structured data only), ending at this page. */
  crumbs?: readonly Crumb[] | undefined;
}

const { alternates = {}, canonical, content, crumbs, description, image, robots, title } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const chrome = await getSiteChrome(locale, site.name);
if (Astro.cache?.enabled) {
  for (const hint of chrome.cacheHints) {
    Astro.cache.set(hint);
  }
}

const origin = Astro.site?.origin ?? Astro.url.origin;
const homeTitle = locale === "es" ? "EquityFast HELOC | $5K-$1M, sin avalúo bajo $400K" : "EquityFast HELOC | $5K-$1M, No Appraisal Under $400K";
const fullTitle = title === undefined ? homeTitle : documentTitle(title, site.shortName);
// Editors write descriptions of any length; this keeps the snippet within what search engines show.
const pageDescription = metaDescription(description ?? chrome.tagline ?? site.description, site.descriptionContext);
const ogImage = image ?? `${origin}/og-default.png`;

const page = createPublicPageContext({
  Astro,
  canonical: canonical ?? `${origin}${Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/u, "")}`,
  content,
  description: pageDescription,
  image: ogImage,
  kind: content === undefined ? "custom" : "content",
  pageTitle: title ?? chrome.title,
  pageType: "website",
  seo: { ogImage, robots },
  siteName: chrome.title,
  title: fullTitle,
});
const breadcrumbs = crumbs === undefined ? undefined : JSON.stringify(breadcrumbJsonLd(crumbs, origin));
---

<!doctype html>
<html lang={LANGUAGE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b5e" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-body" preload />
    <EmDashHead page={page} />
    <meta property="og:locale" content={LANGUAGE_TAG[locale].replace("-", "_")} />
    {Object.entries(LANGUAGE_TAG).filter(([code]) => code !== locale).map(([, tag]) => <meta property="og:locale:alternate" content={tag.replace("-", "_")} />)}
    <StructuredData origin={origin} locale={locale} />
    {breadcrumbs && <script type="application/ld+json" set:html={breadcrumbs} />}
  </head>
  <body class="flex min-h-svh flex-col">
    <EmDashBodyStart page={page} />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-60 focus:bg-white focus:px-4 focus:py-2 focus:text-navy focus:shadow">{t.skipToContent}</a>
    <SiteHeader locale={locale} items={chrome.primary} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} items={chrome.footer} disclosure={chrome.disclosure} />
    <ApplyDialog client:idle locale={locale} strings={t} turnstileSiteKey={env.TURNSTILE_SITE_KEY} />
    <WebAnalyticsBeacon />
    <EmDashBodyEnd page={page} />
  </body>
</html>
