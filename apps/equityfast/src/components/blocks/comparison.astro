---
/** A feature-by-feature comparison table; on phones each row stacks into a labeled card. */
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import type { PageContentComparisonBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentComparisonBlock>;

const { value } = Astro.props;
---

<section class="py-24 sm:py-32">
  <div class="container-page">
    {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
    <Headline text={value.headline} accent={value.headline_accent} class="mt-5" />
    <div class="mt-14 overflow-hidden rounded-3xl border border-border bg-white shadow-sm">
      <table class="w-full text-left">
        <caption class="sr-only">{value.headline}</caption>
        <thead class="hidden border-b border-border sm:table-header-group">
          <tr>
            <th scope="col" class="px-8 py-5 text-sm font-normal text-slate-blue">{value.feature_label}</th>
            <th scope="col" class="bg-navy-deep px-8 py-5 font-display text-2xl font-normal text-white">{value.ours_label}</th>
            <th scope="col" class="px-8 py-5 text-sm font-normal text-slate-blue">{value.theirs_label}</th>
          </tr>
        </thead>
        <tbody>
          {value.rows.map((row) => (
            <tr class="grid border-t border-border first:border-t-0 sm:table-row">
              <th scope="row" class="px-6 pt-6 text-sm font-medium text-slate-blue sm:px-8 sm:py-6">{row.feature}</th>
              <td class="px-6 pt-2 text-lg font-medium text-navy sm:bg-mist/60 sm:px-8 sm:py-6">
                <span class="block text-xs text-sky-ink sm:hidden">{value.ours_label}</span>{row.ours}
              </td>
              <td class="px-6 pt-2 pb-6 text-slate-blue sm:px-8 sm:py-6">
                <span class="block text-xs sm:hidden">{value.theirs_label}</span>{row.theirs}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
