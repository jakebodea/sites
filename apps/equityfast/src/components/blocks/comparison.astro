---
/** A feature-by-feature comparison table; on phones each row stacks into a labeled card. */
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import type { PageContentComparisonBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentComparisonBlock>;

const { value } = Astro.props;
---

<section class="bg-mist py-20 sm:py-24">
  <div class="container-page">
    {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
    <Headline text={value.headline} accent={value.headline_accent} class="mt-4" />
    <table class="mt-10 w-full border border-border bg-white text-left shadow-sm">
      <caption class="sr-only">{value.headline}</caption>
      <thead class="hidden bg-navy text-white sm:table-header-group">
        <tr>
          <th scope="col" class="px-8 py-5 text-xs font-semibold tracking-label uppercase">{value.feature_label}</th>
          <th scope="col" class="px-8 py-5 text-xs font-semibold tracking-label text-gold uppercase">{value.ours_label}</th>
          <th scope="col" class="px-8 py-5 text-xs font-semibold tracking-label uppercase">{value.theirs_label}</th>
        </tr>
      </thead>
      <tbody>
        {value.rows.map((row) => (
          <tr class="grid border-t border-border first:border-t-0 sm:table-row">
            <th scope="row" class="px-6 pt-5 text-xs font-bold tracking-label text-navy uppercase sm:px-8 sm:py-6">{row.feature}</th>
            <td class="px-6 pt-2 text-lg font-semibold text-navy sm:px-8 sm:py-6">
              <span class="block text-[10px] font-semibold tracking-label text-sky-ink uppercase sm:hidden">{value.ours_label}</span>{row.ours}
            </td>
            <td class="px-6 pt-2 pb-5 text-slate-blue sm:px-8 sm:py-6">
              <span class="block text-[10px] font-semibold tracking-label uppercase sm:hidden">{value.theirs_label}</span>{row.theirs}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
