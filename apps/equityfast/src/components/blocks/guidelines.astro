---
/** Program guidelines: headline, text, and a link beside a spec sheet of label/value facts. */
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import type { PageContentGuidelinesBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentGuidelinesBlock>;

const { value } = Astro.props;
---

<section class="bg-paper py-24 sm:py-32">
  <div class="container-page grid *:min-w-0 gap-14 lg:grid-cols-[1fr_1.35fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
      <Headline text={value.headline} accent={value.headline_accent} class="mt-5" />
      {value.body && <p class="mt-7 max-w-md text-lg leading-relaxed text-slate-blue">{value.body}</p>}
      {value.link_label && value.link_url && (
        <a href={sanitizeHref(value.link_url)} class="group mt-9 inline-flex items-center gap-2 font-medium text-navy underline decoration-gold decoration-2 underline-offset-8 hover:decoration-navy">
          {value.link_label}<ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      )}
    </div>
    <div>
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border shadow-sm sm:grid-cols-3">
        {value.items.map((item) => (
          <div class="bg-white px-5 py-6 hyphens-auto last:odd:col-span-2 sm:px-6 sm:py-7 sm:last:odd:col-span-1">
            <dt class="text-sm text-slate-blue">{item.label}</dt>
            <dd class="mt-2 text-lg leading-snug font-medium text-navy">{item.value}</dd>
          </div>
        ))}
      </dl>
      {value.footnote && <p class="mt-6 text-sm leading-relaxed text-slate-blue">{value.footnote}</p>}
    </div>
  </div>
</section>
