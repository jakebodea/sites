---
/** Side-by-side program cards on mist, each with a badge and a feature list. */
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import { cn } from "@/lib/utils";
import type { PageContentProgramsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentProgramsBlock>;

const { value } = Astro.props;
const lines = (text: string) => text.split("\n").map((line) => line.trim()).filter((line) => line !== "");
// Alternate badge colors: navy, then gold, as on the previous site.
const badge = (index: number) => (index % 2 === 0 ? "bg-navy text-white" : "bg-gold text-navy-deep");
const bullet = (index: number) => (index % 2 === 0 ? "bg-sky" : "bg-gold");
---

<section class="bg-mist py-20 sm:py-24">
  <div class="container-page">
    {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
    <Headline text={value.headline} accent={value.headline_accent} class="mt-4 [&>span]:italic" />
    {value.body && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-blue">{value.body}</p>}
    <div class="mt-12 grid border border-border bg-white md:grid-cols-2">
      {value.items.map((program, index) => (
        <article class="p-8 sm:p-10 md:border-l md:first:border-l-0">
          {program.badge && <p class={cn("inline-block px-3 py-1 text-[11px] font-bold tracking-label uppercase", badge(index))}>{program.badge}</p>}
          <h3 class="mt-5 text-2xl font-semibold tracking-[0.02em] uppercase">{program.title}</h3>
          {program.body && <p class="mt-3 leading-relaxed text-slate-blue">{program.body}</p>}
          <ul class="mt-6 border-t border-border">
            {lines(program.features).map((feature) => (
              <li class="flex items-center gap-3 border-b border-border py-3.5 text-navy">
                <span class={cn("size-1.5 shrink-0 rounded-full", bullet(index))} aria-hidden="true"></span>{feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
