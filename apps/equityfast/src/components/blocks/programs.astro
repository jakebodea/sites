---
/** Side-by-side program cards on mist, each with a badge and a feature list. */
import Check from "@lucide/astro/icons/check";
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import { cn } from "@/lib/utils";
import type { PageContentProgramsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentProgramsBlock>;

const { value } = Astro.props;
const lines = (text: string) => text.split("\n").map((line) => line.trim()).filter((line) => line !== "");
// Alternate the pair: the first program on navy, the second on white, each with its badge color from the previous site.
const card = (index: number) => (index % 2 === 0 ? "bg-navy-deep text-white shadow-xl" : "border border-border bg-white shadow-xs");
const badge = (index: number) => (index % 2 === 0 ? "bg-white/10 text-sky" : "bg-gold text-navy-deep");
const bullet = (index: number) => (index % 2 === 0 ? "text-sky" : "text-gold-deep");
---

<section class="bg-mist py-24 sm:py-32">
  <div class="container-page">
    {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
    <Headline text={value.headline} accent={value.headline_accent} class="mt-5" />
    {value.body && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-blue">{value.body}</p>}
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {value.items.map((program, index) => (
        <article class={cn("rounded-3xl p-8 sm:p-10", card(index))}>
          {program.badge && <p class={cn("inline-flex rounded-full px-3 py-1 text-xs font-medium", badge(index))}>{program.badge}</p>}
          <h3 class={cn("mt-6 font-display text-4xl font-normal tracking-normal", index % 2 === 0 && "text-white")}>{program.title}</h3>
          {program.body && <p class={cn("mt-3 leading-relaxed", index % 2 === 0 ? "text-white/70" : "text-slate-blue")}>{program.body}</p>}
          <ul class={cn("mt-8 border-t", index % 2 === 0 ? "border-white/12" : "border-border")}>
            {lines(program.features).map((feature) => (
              <li class={cn("flex items-start gap-3 border-b py-3.5", index % 2 === 0 ? "border-white/12 text-white/90" : "border-border text-navy")}>
                <Check class={cn("mt-1 size-4 shrink-0", bullet(index))} stroke-width={2.25} aria-hidden="true" />{feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
