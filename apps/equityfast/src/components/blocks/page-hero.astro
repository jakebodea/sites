---
/** Page opener (the page's h1): two-tone headline, intro, optional application button, over a photo. */
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import { applyHref } from "@/lib/apply";
import type { PageContentPageHeroBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentPageHeroBlock>;

const { value } = Astro.props;
---

<section class="relative isolate flex min-h-[min(78svh,760px)] items-end overflow-hidden bg-navy-deep text-white">
  {value.image && (
    <Image image={value.image} alt="" priority sizes="100vw" class="absolute inset-0 -z-20 size-full! object-cover" />
  )}
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-navy/55 via-navy/75 to-navy-deep" aria-hidden="true"></div>
  <div class="container-page pt-32 pb-16 sm:pb-20 lg:pb-24">
    <Headline as="h1" text={value.headline} accent={value.headline_accent} tone="dark" class="text-[clamp(2.75rem,8vw,5.5rem)]! leading-[0.98]! text-white [&>span]:italic" />
    {value.intro && <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">{value.intro}</p>}
    {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="accent" size="hero" class="mt-9">{value.apply_label}</ButtonLink>}
  </div>
</section>
