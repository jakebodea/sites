---
/** A row of big serif figures with small labels, on navy. */
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentStatsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentStatsBlock>;

const { value } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy-deep py-16 text-white sm:py-20">
  <div class="glow-navy absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page">
    {value.headline && <h2 class="sr-only">{value.headline}</h2>}
    <dl class="grid grid-cols-2 gap-y-12 lg:grid-cols-4 lg:divide-x lg:divide-white/10">
      {value.items.map((item) => (
        <div class="flex flex-col-reverse gap-3 px-2 lg:px-8 lg:first:pl-0">
          <dt class="text-sm text-white/60">{item.label}</dt>
          <dd class="font-display text-[clamp(3rem,5vw,4.25rem)] leading-none text-white lg:whitespace-nowrap">{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
