---
/** A vertical timeline: gold dots on a thin rule, each stage's label and what happens. */
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentTimelineBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentTimelineBlock>;

const { value } = Astro.props;
---

<section class="py-24 sm:py-32">
  <div class="container-page grid *:min-w-0 gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
    <h2 class="headline-section lg:sticky lg:top-32 lg:self-start">{value.headline}</h2>
    <ol class="relative space-y-12 before:absolute before:top-2 before:bottom-2 before:left-[5px] before:w-px before:bg-linear-to-b before:from-gold before:via-sky before:to-navy/20">
      {value.items.map((item) => (
        <li class="relative pl-10">
          <span class="absolute top-1.5 left-0 size-[11px] rounded-full border-2 border-gold bg-white" aria-hidden="true"></span>
          <h3 class="eyebrow text-sky-ink before:hidden">{item.label}</h3>
          <p class="mt-3 text-xl leading-relaxed text-navy">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
