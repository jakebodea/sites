---
/**
 * Home opener: the tagline, the CMS headline as the page's h1 (the part
 * after its colon set in italic sky), intro, two buttons, lender facts, and
 * the quick equity estimate, over a photo under a navy wash.
 */
import { sanitizeHref } from "emdash";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import EquityEstimator from "@/components/islands/equity-estimator";
import { toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { applyHref } from "@/lib/apply";
import type { PageContentHomeHeroBlock } from "../../../emdash-env";
import { site } from "../../../site.config";

type Props = BlockComponentProps<PageContentHomeHeroBlock>;

const { value } = Astro.props;
const t = ui(toLocale(Astro.currentLocale));
const apply = applyHref(Astro.currentLocale);
// "Get EquityFast: home equity, reimagined" sets the clause after the colon as the accent line.
const [lead, ...rest] = value.headline.split(/(?<=:)\s+/u);
const accent = rest.join(" ");
---

<section class="relative isolate overflow-hidden bg-navy-deep text-white">
  {value.image && (
    <Image image={value.image} alt="" priority sizes="100vw" class="absolute inset-0 -z-30 size-full! object-cover opacity-55" />
  )}
  <div class="absolute inset-0 -z-20 bg-linear-to-b from-navy-deep/70 via-navy-deep/80 to-navy-deep lg:bg-linear-to-r lg:from-navy-deep lg:via-navy-deep/85 lg:to-navy-deep/40" aria-hidden="true"></div>
  <div class="glow-navy absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page grid *:min-w-0 items-center gap-14 pt-16 pb-20 sm:pt-24 lg:min-h-[calc(100svh-72px-49px)] lg:grid-cols-[1.2fr_1fr] lg:gap-20 lg:py-24">
    <div class="text-center lg:text-left">
      <p class="eyebrow text-gold">{value.tagline}</p>
      <Headline as="h1" size="hero" text={lead ?? value.headline} accent={accent} tone="dark" class="mt-7 text-[clamp(2.75rem,6.4vw,5.25rem)]! text-white" />
      {value.intro && <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-white/75 sm:text-xl lg:mx-0">{value.intro}</p>}
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
        {value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="hero">{value.apply_label}<ArrowRight class="size-4" aria-hidden="true" /></ButtonLink>}
        {value.secondary_cta_label && value.secondary_cta_url && (
          <ButtonLink href={sanitizeHref(value.secondary_cta_url)} variant="outline-inverse" size="hero">{value.secondary_cta_label}</ButtonLink>
        )}
      </div>
      <p class="mt-9 text-sm text-white/50">{t.poweredBy} {site.business.legalName} · NMLS #{site.business.nmls}</p>
    </div>
    {value.show_estimator !== false && (
      <div><EquityEstimator client:visible strings={t.estimator} applyHref={apply} /></div>
    )}
  </div>
</section>
