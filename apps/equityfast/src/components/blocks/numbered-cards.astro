---
/**
 * Numbered points (01, 02, ...). Light: a three-up grid under the headline.
 * Navy: the headline and button stay beside a column of step cards.
 */
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import { applyHref } from "@/lib/apply";
import type { PageContentNumberedCardsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentNumberedCardsBlock>;

const { value } = Astro.props;
const navy = value.tone === "navy";
const number = (index: number) => String(index + 1).padStart(2, "0");
---

{navy ? (
  <section class="relative isolate overflow-hidden bg-navy-deep py-24 text-white sm:py-32">
    <div class="glow-navy absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-page grid *:min-w-0 gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        {value.eyebrow && <p class="eyebrow text-gold">{value.eyebrow}</p>}
        <Headline text={value.headline} accent={value.headline_accent} tone="dark" class="mt-5 text-white" />
        {value.body && <p class="mt-7 max-w-md text-lg text-white/70">{value.body}</p>}
        {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="accent" size="hero" class="mt-10">{value.apply_label}</ButtonLink>}
      </div>
      <ol class="relative space-y-4">
        {value.items.map((item, index) => (
          <li class="flex gap-6 rounded-2xl border border-white/10 bg-white/4 p-7 backdrop-blur-sm sm:p-8">
            <p class="font-display text-4xl leading-none text-gold" aria-hidden="true">{number(index)}</p>
            <div>
              <h3 class="text-xl text-white">{item.title}</h3>
              <p class="mt-2 text-white/65">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
) : (
  <section class="py-24 sm:py-32">
    <div class="container-page">
      {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
      <Headline text={value.headline} accent={value.headline_accent} class="mt-5 max-w-3xl" />
      {value.body && <p class="mt-7 max-w-2xl text-lg text-slate-blue">{value.body}</p>}
      <ol class="mt-16 grid gap-12 md:grid-cols-3 md:gap-10">
        {value.items.map((item, index) => (
          <li class="border-t border-navy/15 pt-7">
            <p class="font-display text-5xl leading-none text-sky-ink" aria-hidden="true">{number(index)}</p>
            <h3 class="mt-6 text-xl">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-blue">{item.body}</p>
          </li>
        ))}
      </ol>
      {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="accent" size="hero" class="mt-14">{value.apply_label}</ButtonLink>}
    </div>
  </section>
)}
