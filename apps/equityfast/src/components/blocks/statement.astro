---
/** A large centered statement: two-tone headline, a big lead sentence, and a short paragraph. */
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentStatementBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentStatementBlock>;

const { value } = Astro.props;
---

<section class="py-24 text-center sm:py-36">
  <div class="container-page max-w-5xl">
    <h2 class="headline-section text-[clamp(2.75rem,7vw,5.5rem)]!">
      {value.headline}{value.headline_accent && <> <span class="text-sky-ink italic">{value.headline_accent}</span></>}
    </h2>
    {value.lead && <p class="mx-auto mt-10 max-w-3xl text-[clamp(1.35rem,2.6vw,1.9rem)] leading-snug text-navy">{value.lead}</p>}
    {value.body && <p class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-slate-blue">{value.body}</p>}
  </div>
</section>
