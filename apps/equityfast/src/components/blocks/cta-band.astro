---
/**
 * Closing call to action. Centered on navy (optionally with the Instagram
 * link), split (text left, buttons right), or boxed (a navy panel on white).
 */
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import InstagramIcon from "@/components/instagram-icon.astro";
import { toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { applyHref } from "@/lib/apply";
import { site } from "../../../site.config";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
const t = ui(toLocale(Astro.currentLocale));
const layout = value.layout ?? "centered";
const apply = applyHref(Astro.currentLocale);
const secondary = value.secondary_cta_label && value.secondary_cta_url ? { href: sanitizeHref(value.secondary_cta_url), label: value.secondary_cta_label } : undefined;
---

{layout === "centered" && (
  <section class="bg-navy-deep py-20 text-center text-white sm:py-28">
    <div class="container-page max-w-4xl">
      <h2 class="headline-section text-white">{value.headline}</h2>
      {value.body && <p class="mx-auto mt-5 max-w-xl text-lg text-white/80">{value.body}</p>}
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        {value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="hero">{value.apply_label}</ButtonLink>}
        {secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="hero">{secondary.label}</ButtonLink>}
      </div>
      {value.show_social && (
        <a href={site.business.instagram} rel="noopener me" target="_blank" class="mt-7 inline-flex items-center gap-2 text-xs font-semibold tracking-label text-white/85 uppercase hover:text-gold">
          <InstagramIcon class="size-4" />{t.followUs}
        </a>
      )}
    </div>
  </section>
)}
{layout === "split" && (
  <section class="bg-linear-to-r from-navy-deep to-navy py-16 text-white sm:py-20">
    <div class="container-page flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight text-white">{value.headline}</h2>
        {value.body && <p class="mt-3 text-lg text-white/80">{value.body}</p>}
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        {secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="cta">{secondary.label}</ButtonLink>}
        {value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="cta">{value.apply_label}</ButtonLink>}
      </div>
    </div>
  </section>
)}
{layout === "boxed" && (
  <section class="pb-20 sm:pb-24">
    <div class="container-page">
      <div class="flex flex-col gap-8 bg-navy p-8 text-white sm:p-10 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-[0.02em] text-white uppercase sm:text-3xl">{value.headline}</h2>
          {value.body && <p class="mt-2 text-white/80">{value.body}</p>}
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          {secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="cta">{secondary.label}</ButtonLink>}
          {value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="cta">{value.apply_label}</ButtonLink>}
        </div>
      </div>
    </div>
  </section>
)}
