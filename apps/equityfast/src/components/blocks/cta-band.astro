---
/**
 * Closing call to action on a rounded navy panel. Centered (optionally with
 * the Instagram link), or split and boxed (text left, buttons right; the two
 * render alike now that every band is a panel).
 */
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import InstagramIcon from "@/components/instagram-icon.astro";
import { toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { applyHref } from "@/lib/apply";
import { site } from "../../../site.config";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
const t = ui(toLocale(Astro.currentLocale));
const layout = value.layout ?? "centered";
const apply = applyHref(Astro.currentLocale);
const secondary = value.secondary_cta_label && value.secondary_cta_url ? { href: sanitizeHref(value.secondary_cta_url), label: value.secondary_cta_label } : undefined;
---

<section class="py-20 sm:py-24">
  <div class="container-page">
    <div class:list={[
      "relative isolate overflow-hidden rounded-[2rem] bg-navy-deep text-white shadow-2xl",
      layout === "centered" ? "px-6 py-20 text-center sm:px-12 sm:py-28" : "flex flex-col gap-8 p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between lg:p-14",
    ]}>
      <div class="glow-navy absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class:list={[layout === "centered" && "mx-auto max-w-3xl"]}>
        <h2 class:list={["headline-section text-white", layout !== "centered" && "text-[clamp(2rem,3.6vw,2.75rem)]!"]}>{value.headline}</h2>
        {value.body && <p class:list={["mt-5 text-lg text-white/70", layout === "centered" && "mx-auto max-w-xl"]}>{value.body}</p>}
      </div>
      <div class:list={["flex shrink-0 flex-col gap-3 sm:flex-row", layout === "centered" && "mt-10 items-center justify-center"]}>
        {layout !== "centered" && secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="hero">{secondary.label}</ButtonLink>}
        {value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="hero">{value.apply_label}<ArrowRight class="size-4" aria-hidden="true" /></ButtonLink>}
        {layout === "centered" && secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="hero">{secondary.label}</ButtonLink>}
      </div>
      {layout === "centered" && value.show_social && (
        <a href={site.business.instagram} rel="noopener me" target="_blank" class="mt-8 inline-flex items-center gap-2 text-sm text-white/60 hover:text-white">
          <InstagramIcon class="size-4" />{t.followUs}
        </a>
      )}
    </div>
  </div>
</section>
