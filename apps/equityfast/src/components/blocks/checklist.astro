---
/** Headline, text, and an optional application button beside a list of checked benefits. */
import Check from "@lucide/astro/icons/check";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import { applyHref } from "@/lib/apply";
import type { PageContentChecklistBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentChecklistBlock>;

const { value } = Astro.props;
---

<section class="py-24 sm:py-32">
  <div class="container-page grid *:min-w-0 gap-14 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      {value.eyebrow && <p class="eyebrow text-sky-ink">{value.eyebrow}</p>}
      <Headline text={value.headline} accent={value.headline_accent} class="mt-5" />
      {value.body && <p class="mt-7 max-w-md text-lg leading-relaxed text-slate-blue">{value.body}</p>}
      {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="outline-navy" size="hero" class="mt-10">{value.apply_label}</ButtonLink>}
    </div>
    <ul class="grid gap-4 sm:grid-cols-2">
      {value.items.map((item) => (
        <li class="rounded-2xl border border-border bg-white p-7 shadow-xs">
          <span class="flex size-10 items-center justify-center rounded-full bg-mist text-sky-ink" aria-hidden="true">
            <Check class="size-5" stroke-width={2.25} />
          </span>
          <h3 class="mt-6 text-lg leading-snug">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-slate-blue">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
