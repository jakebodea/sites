---
/** Headline, text, and an optional application button beside a list of checked benefits. */
import Check from "@lucide/astro/icons/check";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import { applyHref } from "@/lib/apply";
import type { PageContentChecklistBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentChecklistBlock>;

const { value } = Astro.props;
---

<section class="py-20 sm:py-24">
  <div class="container-page grid *:min-w-0 gap-12 lg:grid-cols-2 lg:gap-0">
    <div class="lg:pr-16">
      <Headline text={value.headline} accent={value.headline_accent} />
      <div class="mt-6 h-1 w-16 bg-gold" aria-hidden="true"></div>
      {value.body && <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-blue">{value.body}</p>}
      {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="outline-navy" size="hero" class="mt-9">{value.apply_label}</ButtonLink>}
    </div>
    <ul class="space-y-8 border-sky/40 lg:border-l lg:pl-12">
      {value.items.map((item) => (
        <li class="flex gap-5">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-sm border border-sky/50 bg-mist text-sky-ink" aria-hidden="true">
            <Check class="size-5" stroke-width={3} />
          </span>
          <div>
            <h3 class="text-base font-semibold tracking-[0.04em] uppercase">{item.title}</h3>
            <p class="mt-1 leading-relaxed text-slate-blue">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
