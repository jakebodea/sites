---
/**
 * Lender identity (legal name, address, NMLS, Equal Housing), the locale's
 * footer menu, and the CMS-edited disclosures. The NMLS number and address
 * come from site.config.ts so structured data and the footer never disagree.
 */
import type { Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import type { NavItem } from "@/lib/content";
import { site } from "../../site.config";
import EqualHousingIcon from "./equal-housing-icon.astro";
import InstagramIcon from "./instagram-icon.astro";

interface Props {
  locale: Locale;
  items: readonly NavItem[];
  disclosure: readonly string[];
}

const { disclosure, items, locale } = Astro.props;
const t = ui(locale);
const { address, email, instagram, legalName, nmls } = site.business;
const year = new Date().getFullYear();
const fullAddress = `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`;
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(fullAddress)}`;
---

<footer class="relative isolate overflow-hidden bg-navy-deep text-white/70">
  <div class="mx-auto grid w-full max-w-[1440px] gap-12 px-5 pt-20 pb-12 sm:px-8 md:grid-cols-[1.4fr_1fr_auto] lg:px-10">
    <div class="space-y-6">
      <img src="/brand/equityfast.webp" alt="EquityFast" width="1200" height="172" loading="lazy" class="h-7 w-auto" />
      <p class="max-w-xs text-sm leading-relaxed">{t.poweredBy} {legalName}<br />NMLS #{nmls} · {t.equalHousing}</p>
      <div class="flex items-center gap-4">
        <EqualHousingIcon class="size-9 text-white/80" label={t.equalHousing} />
        <a href={instagram} rel="noopener me" target="_blank" class="flex size-9 items-center justify-center rounded-full border border-white/15 text-white/80 hover:border-white/40 hover:text-white" aria-label="Instagram @equityfast">
          <InstagramIcon class="size-4" />
        </a>
      </div>
    </div>
    <address class="space-y-2 text-sm not-italic">
      <a href={mapsHref} rel="noopener" target="_blank" class="block leading-relaxed hover:text-white">{address.street}<br />{address.city}, {address.region} {address.postalCode}</a>
      <a href={`mailto:${email}`} class="block hover:text-white">{email}</a>
    </address>
    <nav aria-label={t.footerNav}>
      <ul class="grid gap-x-10 gap-y-2.5 text-sm sm:grid-cols-2 md:grid-cols-1">
        {items.map((item) => (
          <li><a href={item.url} class="inline-flex min-h-6 items-center text-white/80 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-10">
    <div class="space-y-3 border-t border-white/8 pt-8 text-xs leading-relaxed text-white/45">
      {disclosure.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="pb-safe pt-6 text-xs text-white/45">&copy; {year} {legalName} {t.rights}</p>
  </div>
</footer>
