---
/**
 * Lender identity (legal name, address, NMLS, Equal Housing), the locale's
 * footer menu, and the CMS-edited disclosures. The NMLS number and address
 * come from site.config.ts so structured data and the footer never disagree.
 */
import type { Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import type { NavItem } from "@/lib/content";
import { site } from "../../site.config";
import EqualHousingIcon from "./equal-housing-icon.astro";
import InstagramIcon from "./instagram-icon.astro";

interface Props {
  locale: Locale;
  items: readonly NavItem[];
  disclosure: readonly string[];
}

const { disclosure, items, locale } = Astro.props;
const t = ui(locale);
const { address, email, instagram, legalName, nmls } = site.business;
const year = new Date().getFullYear();
const fullAddress = `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`;
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(fullAddress)}`;
---

<footer class="bg-navy-deep text-white/75">
  <div class="mx-auto grid w-full max-w-[1440px] gap-10 px-5 pt-14 pb-10 sm:px-8 md:grid-cols-[1fr_auto] lg:px-10">
    <div class="space-y-5">
      <div>
        <p class="text-sm font-semibold tracking-[0.3em] text-white uppercase">EquityFast</p>
        <p class="mt-1 text-xs font-semibold tracking-[0.3em] text-gold uppercase">{legalName}</p>
      </div>
      <address class="space-y-1 text-sm not-italic">
        <a href={mapsHref} rel="noopener" target="_blank" class="block hover:text-white">{address.street}<br />{address.city}, {address.region} {address.postalCode}</a>
        <a href={`mailto:${email}`} class="block hover:text-white">{email}</a>
      </address>
      <a href={instagram} rel="noopener me" target="_blank" class="inline-flex items-center gap-2 text-xs font-semibold tracking-label text-white uppercase hover:text-gold">
        <InstagramIcon class="size-4" />@equityfast
      </a>
      <p class="text-xs tracking-label text-white/60 uppercase">NMLS #{nmls} · {t.equalHousing}</p>
      <EqualHousingIcon class="size-11 text-white" label={t.equalHousing} />
    </div>
    <nav aria-label={t.footerNav}>
      <ul class="grid gap-2.5 text-xs font-semibold tracking-label uppercase sm:grid-cols-2 md:grid-cols-1">
        {items.map((item) => (
          <li><a href={item.url} class="inline-flex min-h-6 items-center hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-10">
    <div class="space-y-3 border-t border-white/10 pt-6 text-[11px] leading-relaxed text-white/55">
      {disclosure.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="pb-safe pt-5 text-[11px] text-white/55">&copy; {year} {legalName} {t.rights}</p>
  </div>
</footer>
