---
/**
 * The application on its own page: where every "Start" link goes before the
 * dialog island loads (or without JavaScript), and a shareable landing URL.
 * `?amount=` carries an estimate over. Kept out of search: it duplicates the
 * dialog and has no content of its own.
 */
import { env } from "cloudflare:workers";

import ApplicationForm from "@/components/islands/application-form";
import Base from "@/layouts/base.astro";
import { APPLY_PATH, localePath, toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { formatDollars, isAmount } from "@/lib/application-rules";
import { site } from "../../../site.config";

const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const requested = Astro.url.searchParams.get("amount") ?? "";
const amount = isAmount(requested) ? formatDollars(requested) : undefined;
---

<Base
  title={t.applyTitle}
  description={t.applyIntro}
  robots="noindex, follow"
  alternates={{ en: APPLY_PATH.en, es: APPLY_PATH.es }}
  crumbs={[{ label: locale === "es" ? "Inicio" : "Home", path: localePath(locale, "/") }, { label: t.applyTitle, path: APPLY_PATH[locale] }]}
>
  <section class="relative isolate bg-paper py-14 sm:py-24">
    <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-navy-deep" aria-hidden="true"><div class="glow-navy size-full"></div></div>
    <div class="mx-auto w-full max-w-xl px-5">
      <p class="eyebrow text-gold">{t.applyEyebrow}</p>
      <h1 class="sr-only">{t.applyTitle}</h1>
      <div class="mt-4 rounded-3xl border border-border bg-white p-6 shadow-2xl sm:p-9">
        <ApplicationForm client:only="react" locale={locale} strings={t} turnstileSiteKey={env.TURNSTILE_SITE_KEY} initialAmount={amount} homeHref={localePath(locale, "/")}>
          <p slot="fallback" class="text-slate-blue">{t.applyIntro} <a href={`mailto:${site.business.email}`} class="font-semibold text-navy underline underline-offset-4">{site.business.email}</a></p>
        </ApplicationForm>
      </div>
    </div>
  </section>
</Base>
