---
/**
 * Page shell: head tags (title, description, canonical, Open Graph,
 * structured data), fonts, header and footer, the referral-link memory, and
 * analytics on prod when a PostHog key is set.
 */
import "@/styles/global.css";

import { Font } from "astro:assets";
import { env } from "cloudflare:workers";
import { documentTitle, metaDescription } from "@jakebodea/cloudflare-kit/seo";

import AnalyticsScript from "@/components/analytics-script.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import StructuredData from "@/components/structured-data.astro";
import { footerNav, primaryNav } from "@/content/navigation";
import { site } from "../../site.config";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string | undefined;
  description?: string | undefined;
  robots?: string | undefined;
}

const { description, robots, title } = Astro.props;

const origin = Astro.site?.origin ?? Astro.url.origin;
const fullTitle = title === undefined ? `${site.name} | ${site.titleSuffix}` : documentTitle(title, site.shortName);
// Keeps every snippet within what search engines show.
const pageDescription = metaDescription(description ?? site.description, site.descriptionContext);
const canonical = `${origin}${Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/u, "")}`;
const ogImage = `${origin}/og-default.png`;

const analytics = {
  enabled: env.STAGE === "prod",
  projectKey: env.POSTHOG_PROJECT_KEY,
  proxyPath: env.POSTHOG_PROXY_PATH,
  siteHost: new URL(origin).hostname,
  uiHost: env.POSTHOG_HOST.replace(".i.posthog.com", ".posthog.com"),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-accent" preload />
    <Font cssVariable="--font-label" />
    <StructuredData origin={origin} />
  </head>
  <body class="flex min-h-svh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-background focus:px-4 focus:py-2 focus:shadow">Skip to content</a>
    <SiteHeader title={site.name} items={primaryNav} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter title={site.name} tagline={site.tagline} items={footerNav} />
    {analytics.enabled && analytics.projectKey !== "" && <AnalyticsScript config={analytics} />}
    <script>
      import "@/scripts/referral";
    </script>
  </body>
</html>
