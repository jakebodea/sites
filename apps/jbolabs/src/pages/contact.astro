---
import { env } from "cloudflare:workers";

import Headline from "@/components/headline.astro";
import ContactForm from "@/components/islands/contact-form";
import { contact } from "@/content/pages";
import Base from "@/layouts/base.astro";
import { site } from "../../site.config";
---

<Base title={contact.title} description={contact.description}>
  <!-- On phones the form follows the intro directly; the details come after it. -->
  <section class="container-page grid gap-12 pt-14 pb-10 sm:pt-16 lg:grid-cols-[1fr_1.35fr] lg:grid-rows-[auto_1fr] lg:gap-x-16">
    <div>
      <h1 class="rise display text-[2.6rem] leading-[1.05] sm:text-6xl sm:leading-[1.02]"><Headline text={contact.headline} /></h1>
      <p class="rise mt-6 max-w-md text-lg leading-relaxed text-muted-foreground [animation-delay:80ms]">{contact.intro}</p>
    </div>


    <div class="rise rounded-[2rem] bg-muted p-6 sm:p-10 lg:col-start-2 lg:row-span-2 lg:row-start-1 [animation-delay:120ms]">
      <ContactForm client:visible turnstileSiteKey={env.TURNSTILE_SITE_KEY} />
      <p class="mt-8 text-sm text-muted-foreground">Your details are used only to reply to you. See the <a href="/privacy" class="text-signal underline decoration-signal/30 underline-offset-4 hover:decoration-signal">privacy notes</a>.</p>
    </div>

    <aside class="lg:col-start-1 lg:row-start-2">
      <div class="rise [animation-delay:160ms]">
        <h2 class="text-sm font-semibold">What happens next</h2>
        <ol class="mt-5">
          {contact.nextSteps.map((step, index) => (
            <li class="relative flex gap-4 pb-6 last:pb-0">
              {index < contact.nextSteps.length - 1 && <span class="absolute top-4 bottom-0 left-[4.5px] w-px bg-input" aria-hidden="true"></span>}
              <span class:list={["relative mt-[0.45rem] size-2.5 shrink-0 rounded-full ring-4 ring-background", index === contact.nextSteps.length - 1 ? "bg-signal" : "bg-ink"]} aria-hidden="true"></span>
              <span class="leading-relaxed text-ink-soft">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="rise mt-12 flex items-center gap-4 border-t border-border pt-8 [animation-delay:240ms]">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-bold text-background" aria-hidden="true">jb</span>
        <p class="text-sm leading-relaxed text-muted-foreground">
          <span class="block font-medium text-foreground">{site.business.founder}</span>
          {site.business.email ? <a href={`mailto:${site.business.email}`} class="text-signal underline decoration-signal/30 underline-offset-4 hover:decoration-signal">{site.business.email}</a> : "Reads and answers every enquiry personally."}
        </p>
      </div>
    </aside>
  </section>
</Base>
