---
/**
 * The text wordmark, set like the logo: lowercase Montserrat with the first
 * word bold ("jbo") and the rest hairline ("labs"). It reads `site.name` from
 * site.config.ts, so renaming the studio needs no new artwork.
 */
interface Props {
  title: string;
  class?: string;
}

const { class: className, title } = Astro.props;
const [lead = "", ...rest] = title.toLowerCase().split(" ");
---

<span class:list={["font-display text-[1.45rem] leading-none tracking-[-0.03em]", className]}>
  <span class="font-bold">{lead}</span><span class="font-extralight">{rest.join("")}</span>
</span>
