---
import type { Link } from "@/content/types";
import MobileNav from "./islands/mobile-nav";
import ThemeToggle from "./islands/theme-toggle";
import ButtonLink from "./button-link.astro";
import Wordmark from "./wordmark.astro";

interface Props {
  title: string;
  items: readonly Link[];
}

const { items, title } = Astro.props;
const current = Astro.url.pathname;
const isActive = (url: string) =>
  url === "/" ? current === "/" : current === url || current.startsWith(`${url}/`);
---

<header class="sticky top-0 z-40 bg-background">
  <div class="container-page flex h-15 items-center justify-between gap-6 sm:h-16">
    <a href="/" class="rounded-sm" aria-label={`${title}, home`}>
      <Wordmark title={title} />
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 md:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle client:idle />
      <ButtonLink href="/contact" size="cta">Start a project</ButtonLink>
    </nav>
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle client:media="(max-width: 767px)" />
      <MobileNav client:media="(max-width: 767px)" title={title} items={[...items]} currentPath={current} />
    </div>
  </div>
</header>
