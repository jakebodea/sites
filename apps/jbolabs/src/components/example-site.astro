---
/**
 * Hero illustration: a browser-framed template site visitors can edit in place.
 * Brand swatches and a playful mobile menu need a tiny script; everything
 * else is contenteditable fields and CSS `:has()`.
 */
import { Menu, MousePointerClick, X } from "@lucide/astro";

import type { HeroExample } from "@/content/types";
import { cn } from "@/lib/utils";

interface Props {
  value: HeroExample;
  class?: string;
}

const { class: className, value } = Astro.props;
const businesses = value.businesses.slice(0, 4);
const [defaultBusiness] = businesses;
const defaultHue = defaultBusiness?.hue ?? 258;
const menuLinks = ["Services", "About", "Contact"];
const copy = {
  body: "Subtitle goes here. A short line about what you do.",
  cta: "Get started",
  headline: "Heading here",
  name: "ACME Company",
};
const swatchRules = businesses
  .map(
    (business, index) =>
      `.example:has(input[data-swatch="${index}"]:checked) { --hue: ${business.hue}; }`,
  )
  .join("\n");
---

{defaultBusiness && (
<figure
  class={cn("example mx-auto w-full max-w-xl lg:mr-0", className)}
  data-example-site
  aria-label="Try editing an example website"
>
  <div class="relative rounded-2xl border border-border bg-card shadow-[0_1px_2px_oklch(0.2_0.02_265/0.04),0_32px_64px_-32px_oklch(0.2_0.02_265/0.28)]">
    <div class="overflow-hidden rounded-2xl">
      <div class="flex items-center gap-3 border-b border-border bg-muted/60 px-4 py-2.5" aria-hidden="true">
        <span class="flex gap-1.5">
          <span class="size-2.5 rounded-full bg-foreground/15"></span>
          <span class="size-2.5 rounded-full bg-foreground/15"></span>
          <span class="size-2.5 rounded-full bg-foreground/15"></span>
        </span>
        <span class="min-w-0 flex-1 truncate rounded-md bg-card px-3 py-1 text-center text-xs text-muted-foreground">acmecompany.com</span>
        <span class="w-9 shrink-0"></span>
      </div>

      <div class="relative">
        <div class="flex items-center justify-between gap-4 px-5 py-3.5">
          <span class="flex min-w-0 items-center gap-2 text-sm font-semibold tracking-[-0.01em]">
            <span class="size-2.5 shrink-0 rounded-full bg-(--brand)" aria-hidden="true"></span>
            <span contenteditable="plaintext-only" spellcheck="false" class="editable min-w-0 truncate">{copy.name}</span>
          </span>
          <ul class="hidden shrink-0 items-center gap-4 text-sm text-muted-foreground sm:flex">
            {menuLinks.slice(0, 2).map((label) => (
              <li>{label}</li>
            ))}
            <li class="rounded-full border border-(--brand) px-3.5 py-1 font-medium whitespace-nowrap text-(--brand)" >{copy.cta}</li>
          </ul>
          <button
            type="button"
            class="menu-toggle -mr-1 flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:hidden"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="example-site-menu"
            aria-label="Open menu"
          >
            <Menu class="menu-icon size-4" aria-hidden="true" />
            <X class="menu-close size-4" aria-hidden="true" />
          </button>
        </div>

        <nav
          id="example-site-menu"
          class="menu-panel absolute inset-x-3 top-[3.5rem] z-20 overflow-hidden rounded-2xl border border-border bg-card shadow-[0_12px_40px_-16px_oklch(0.2_0.02_265/0.35)] sm:hidden"
          data-menu-panel
          hidden
        >
          <ul class="flex flex-col gap-0.5 p-1.5">
            {menuLinks.map((label) => (
              <li>
                <button type="button" class="menu-item w-full rounded-xl px-3 py-2.5 text-left text-sm font-medium transition-colors hover:bg-muted" data-menu-item>
                  {label}
                </button>
              </li>
            ))}
            <li>
              <button
                type="button"
                class="menu-item w-full rounded-xl px-3 py-2.5 text-left text-sm font-medium text-(--brand) transition-colors hover:bg-(--brand-soft)"
                data-menu-item
                
              >
                {copy.cta}
              </button>
            </li>
          </ul>
        </nav>

        <div class="mx-2.5 rounded-[1.25rem] bg-(--brand-soft) px-6 pt-9 pb-8 transition-[filter] duration-200 sm:px-9 sm:pt-12 sm:pb-11" data-menu-dim>
          <p contenteditable="plaintext-only" spellcheck="false" class="editable max-w-[16ch] text-[1.9rem] leading-[1.1] font-semibold tracking-[-0.025em] text-balance sm:text-[2.4rem]">
            {copy.headline}
          </p>
          <p contenteditable="plaintext-only" spellcheck="false" class="editable mt-3 max-w-[38ch] text-sm leading-relaxed text-ink-soft sm:text-base">
            {copy.body}
          </p>
          <span class="mt-6 inline-flex h-10 items-center rounded-full bg-(--brand) px-5 text-sm font-medium text-(--brand-ink)">{copy.cta}</span>
        </div>

        <div class="fade-out relative grid grid-cols-3 gap-2.5 px-2.5 pt-2.5 pb-1" aria-hidden="true">
          {[0, 1, 2].map(() => (
            <div class="flex h-24 flex-col gap-2 rounded-2xl border border-border p-3.5">
              <span class="size-6 rounded-lg bg-(--brand-soft)"></span>
              <span class="mt-auto h-2 w-3/4 rounded-full bg-foreground/10"></span>
              <span class="h-2 w-1/2 rounded-full bg-foreground/[0.06]"></span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <span class="hint pointer-events-none absolute -top-3 -left-3 z-30 flex items-center gap-1.5 rounded-full bg-signal px-3 py-1.5 text-xs font-medium text-white shadow-lg">
      <MousePointerClick class="size-3.5" aria-hidden="true" />
      Click any text to edit
    </span>
  </div>
  <div class="mt-5 flex h-6 items-center justify-center gap-3" role="radiogroup" aria-label="Brand color">
    <span class="text-xs font-medium text-muted-foreground">Brand color</span>
    <div class="flex gap-1.5">
      {businesses.map((business, index) => (
        <label
          class="swatch size-5 cursor-pointer rounded-full ring-offset-2 ring-offset-background has-checked:ring-2 has-checked:ring-foreground/70 has-focus-visible:ring-2 has-focus-visible:ring-ring"
          style={`background: oklch(0.55 0.16 ${business.hue})`}
        >
          <input
            type="radio"
            name="example-brand-hue"
            value={index}
            data-swatch={index}
            class="sr-only"
            checked={index === 0}
            aria-label={`${business.kind} brand color`}
          />
        </label>
      ))}
    </div>
  </div>
  <figcaption class="mt-4 text-center text-sm text-muted-foreground">Your site works the same way. Change it, publish, done.</figcaption>
</figure>
)}

<script>
  const figures = document.querySelectorAll<HTMLElement>("[data-example-site]");

  for (const figure of figures) {
    const toggle = figure.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = figure.querySelector<HTMLElement>("[data-menu-panel]");
    const dim = figure.querySelector<HTMLElement>("[data-menu-dim]");
    if (!toggle || !panel) {
      continue;
    }

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
      figure.classList.toggle("menu-open", open);
      if (dim) {
        dim.classList.toggle("is-dimmed", open);
      }
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    for (const item of figure.querySelectorAll<HTMLButtonElement>("[data-menu-item]")) {
      item.addEventListener("click", () => {
        setOpen(false);
      });
    }

    document.addEventListener("click", (event) => {
      if (!figure.classList.contains("menu-open")) {
        return;
      }
      if (event.target instanceof Node && !figure.contains(event.target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && figure.classList.contains("menu-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    for (const editable of figure.querySelectorAll<HTMLElement>(".editable")) {
      editable.addEventListener(
        "focus",
        () => {
          figure.classList.add("hint-dismissed");
        },
        { once: true },
      );
    }
  }
</script>

<style define:vars={{ defaultHue }}>
  .example {
    --hue: var(--defaultHue);
    --brand: oklch(0.55 0.16 var(--hue));
    --brand-soft: oklch(0.95 0.035 var(--hue));
    --brand-ink: oklch(1 0 0);
  }

  :global(.dark) .example {
    --brand: oklch(0.74 0.13 var(--hue));
    --brand-soft: oklch(0.4 0.06 var(--hue));
    --brand-ink: oklch(0.2 0.02 var(--hue));
  }
</style>
<style is:global set:html={swatchRules} />

<style>
  .example .fade-out {
    mask-image: linear-gradient(to bottom, black 20%, transparent);
  }

  .example .editable {
    border-radius: 0.4rem;
    outline: 1.5px dashed transparent;
    outline-offset: 3px;
    cursor: text;
    transition: outline-color 150ms ease-out;
  }

  .example .editable:hover {
    outline-color: color-mix(in oklch, var(--brand) 55%, transparent);
  }

  .example .editable:focus {
    outline: 2px solid var(--brand);
  }

  .example .hint {
    animation: hint-in 400ms cubic-bezier(0.23, 1, 0.32, 1) 600ms both;
    transform-origin: bottom left;
  }

  .example.hint-dismissed .hint {
    opacity: 0;
    transition: opacity 280ms ease-out;
  }

  .example .menu-icon,
  .example .menu-close {
    position: absolute;
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .example .menu-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.85);
  }

  .example.menu-open .menu-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.85);
  }

  .example.menu-open .menu-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .example .menu-toggle {
    position: relative;
  }

  .example .menu-panel {
    animation: menu-in 260ms cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: top right;
  }

  .example .menu-panel[hidden] {
    display: none;
  }

  .example [data-menu-dim].is-dimmed {
    filter: blur(1.5px);
    opacity: 0.55;
  }

  @keyframes hint-in {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(4px);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .example .hint,
    .example .menu-panel,
    .example .menu-icon,
    .example .menu-close {
      animation: none;
      transition: none;
    }
  }
</style>
