---
/**
 * Hero illustration: a phone-sized demo site visitors can edit in place.
 * Brand swatches and a playful mobile menu need a tiny script; everything
 * else is contenteditable fields and CSS `:has()`.
 */
import { Menu, MousePointerClick, X } from "@lucide/astro";

import type { HeroExample } from "@/content/types";
import { cn } from "@/lib/utils";

interface Props {
  value: HeroExample;
  class?: string;
}

const { class: className, value } = Astro.props;
const businesses = value.businesses.slice(0, 4);
const [defaultBusiness] = businesses;
const defaultHue = defaultBusiness?.hue ?? 258;
const menuLinks = ["Services", "Gallery", "Reviews"];
const swatchRules = businesses
  .map(
    (business, index) =>
      `.example:has(input[data-swatch="${index}"]:checked) { --hue: ${business.hue}; }`,
  )
  .join("\n");
---

{defaultBusiness && (
<figure
  class={cn("example mx-auto w-full max-w-sm lg:mr-0", className)}
  data-example-site
  aria-label="Try editing an example website"
>
  <div class="relative rounded-[2.25rem] border border-border bg-card p-2.5 shadow-[0_1px_2px_oklch(0.2_0.02_265/0.04),0_32px_64px_-32px_oklch(0.2_0.02_265/0.28)]">
    <div class="relative z-10 flex items-center justify-between px-3.5 pt-2.5 pb-4">
      <span class="flex min-w-0 items-center gap-2 text-sm font-semibold tracking-[-0.01em]">
        <span class="size-2.5 shrink-0 rounded-full bg-(--brand)" aria-hidden="true"></span>
        <span contenteditable="plaintext-only" spellcheck="false" class="editable min-w-0 truncate">{defaultBusiness.name}</span>
      </span>
      <button
        type="button"
        class="menu-toggle -mr-1 flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="example-site-menu"
        aria-label="Open menu"
      >
        <Menu class="menu-icon size-4" aria-hidden="true" />
        <X class="menu-close size-4" aria-hidden="true" />
      </button>
    </div>

    <nav
      id="example-site-menu"
      class="menu-panel absolute inset-x-3 top-[3.25rem] z-20 overflow-hidden rounded-2xl border border-border bg-card shadow-[0_12px_40px_-16px_oklch(0.2_0.02_265/0.35)]"
      data-menu-panel
      hidden
    >
      <ul class="flex flex-col gap-0.5 p-1.5">
        {menuLinks.map((label) => (
          <li>
            <button type="button" class="menu-item w-full rounded-xl px-3 py-2.5 text-left text-sm font-medium transition-colors hover:bg-muted" data-menu-item>
              {label}
            </button>
          </li>
        ))}
        <li>
          <button
            type="button"
            class="menu-item w-full rounded-xl px-3 py-2.5 text-left text-sm font-medium text-(--brand) transition-colors hover:bg-(--brand-soft)"
            data-menu-item
          >
            {defaultBusiness.cta}
          </button>
        </li>
      </ul>
    </nav>

    <div class="relative rounded-[1.75rem] bg-(--brand-soft) px-6 pt-8 pb-7 transition-[filter] duration-200" data-menu-dim>
      <p contenteditable="plaintext-only" spellcheck="false" class="editable text-[1.7rem] leading-[1.12] font-semibold tracking-[-0.025em] text-balance">
        {defaultBusiness.headline}
      </p>
      <p contenteditable="plaintext-only" spellcheck="false" class="editable mt-3 text-sm leading-relaxed text-ink-soft">
        {defaultBusiness.body}
      </p>
      <span class="mt-6 inline-flex h-10 items-center rounded-full bg-(--brand) px-5 text-sm font-medium text-(--brand-ink)">{defaultBusiness.cta}</span>
    </div>

    <div class="flex items-center justify-between gap-3 px-3.5 pt-4 pb-2">
      <span class="text-xs text-muted-foreground">Brand colour</span>
      <div class="flex gap-1.5">
        {businesses.map((business, index) => (
          <label
            class="swatch size-6 cursor-pointer rounded-full ring-offset-2 ring-offset-card has-checked:ring-2 has-checked:ring-foreground/70"
            style={`--swatch: oklch(0.55 0.16 ${business.hue})`}
          >
            <input
              type="radio"
              name="example-brand-hue"
              value={index}
              data-swatch={index}
              class="sr-only"
              checked={index === 0}
              aria-label={`${business.kind} brand colour`}
            />
          </label>
        ))}
      </div>
    </div>

    <span class="hint pointer-events-none absolute -top-3 -left-3 flex items-center gap-1.5 rounded-full bg-signal px-3 py-1.5 text-xs font-medium text-white shadow-lg">
      <MousePointerClick class="size-3.5" aria-hidden="true" />
      Click any text to edit
    </span>
  </div>
  <figcaption class="mt-5 text-center text-sm text-muted-foreground">Your site works the same way. Change it, publish, done.</figcaption>
</figure>
)}

<script>
  const figures = document.querySelectorAll<HTMLElement>("[data-example-site]");

  for (const figure of figures) {
    const toggle = figure.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = figure.querySelector<HTMLElement>("[data-menu-panel]");
    const dim = figure.querySelector<HTMLElement>("[data-menu-dim]");
    if (!toggle || !panel) {
      continue;
    }

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
      figure.classList.toggle("menu-open", open);
      if (dim) {
        dim.classList.toggle("is-dimmed", open);
      }
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    for (const item of figure.querySelectorAll<HTMLButtonElement>("[data-menu-item]")) {
      item.addEventListener("click", () => {
        setOpen(false);
      });
    }

    document.addEventListener("click", (event) => {
      if (!figure.classList.contains("menu-open")) {
        return;
      }
      if (event.target instanceof Node && !figure.contains(event.target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && figure.classList.contains("menu-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    for (const editable of figure.querySelectorAll<HTMLElement>(".editable")) {
      editable.addEventListener(
        "focus",
        () => {
          figure.classList.add("hint-dismissed");
        },
        { once: true },
      );
    }
  }
</script>

<style define:vars={{ defaultHue }}>
  .example {
    --hue: var(--defaultHue);
    --brand: oklch(0.55 0.16 var(--hue));
    --brand-soft: oklch(0.95 0.035 var(--hue));
    --brand-ink: oklch(1 0 0);
  }

  :global(.dark) .example {
    --brand: oklch(0.74 0.13 var(--hue));
    --brand-soft: oklch(0.4 0.06 var(--hue));
    --brand-ink: oklch(0.2 0.02 var(--hue));
  }
</style>
<style is:global set:html={swatchRules} />

<style>
  .example .swatch {
    background: var(--swatch);
  }

  .example .editable {
    border-radius: 0.4rem;
    outline: 1.5px dashed transparent;
    outline-offset: 3px;
    cursor: text;
    transition: outline-color 150ms ease-out;
  }

  .example .editable:hover {
    outline-color: color-mix(in oklch, var(--brand) 55%, transparent);
  }

  .example .editable:focus {
    outline: 2px solid var(--brand);
  }

  .example .hint {
    animation: hint-in 400ms cubic-bezier(0.23, 1, 0.32, 1) 600ms both;
    transform-origin: bottom left;
  }

  .example.hint-dismissed .hint {
    opacity: 0;
    transition: opacity 280ms ease-out;
  }

  .example .menu-icon,
  .example .menu-close {
    position: absolute;
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .example .menu-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.85);
  }

  .example.menu-open .menu-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.85);
  }

  .example.menu-open .menu-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .example .menu-toggle {
    position: relative;
  }

  .example .menu-panel {
    animation: menu-in 260ms cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: top right;
  }

  .example .menu-panel[hidden] {
    display: none;
  }

  .example [data-menu-dim].is-dimmed {
    filter: blur(1.5px);
    opacity: 0.55;
  }

  @keyframes hint-in {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(4px);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .example .hint,
    .example .menu-panel,
    .example .menu-icon,
    .example .menu-close {
      animation: none;
      transition: none;
    }
  }
</style>
