---
/** The small monospace label that opens a section, optionally numbered. */
interface Props {
  label: string;
  index?: number | undefined;
}

const { index, label } = Astro.props;
---

<p class="label-mono flex items-center gap-3">
  {index !== undefined && <span class="text-foreground">{String(index).padStart(2, "0")}</span>}
  <span>{label}</span>
</p>
