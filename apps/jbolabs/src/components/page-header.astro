---
interface Props {
  title: string;
  intro?: string | undefined;
}

const { intro, title } = Astro.props;
---

<section class="container-page pt-14 pb-12 sm:pt-24 sm:pb-16">
  <h1 class="rise display max-w-3xl text-[2.6rem] leading-[1.05] sm:text-[4.25rem] sm:leading-[1.02]">{title}</h1>
  {intro && <p class="rise mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl [animation-delay:80ms]">{intro}</p>}
  <slot />
</section>
