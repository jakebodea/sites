---
/** Renders a headline from `src/content`, setting `*emphasized*` words bold against the light display weight. */
import { emphasisSegments } from "@/lib/emphasis";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

{emphasisSegments(text).map((segment) => (segment.emphasis ? <strong class="headline-strong">{segment.text}</strong> : segment.text))}
