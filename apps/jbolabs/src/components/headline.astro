---
/** Renders a headline from `src/content`, setting `*emphasized*` words in the serif accent. */
import { emphasisSegments } from "@/lib/emphasis";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

{emphasisSegments(text).map((segment) => (segment.emphasis ? <em class="accent-serif">{segment.text}</em> : segment.text))}
