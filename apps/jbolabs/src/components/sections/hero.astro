---
import ButtonLink from "@/components/button-link.astro";
import ExampleSite from "@/components/example-site.astro";
import Headline from "@/components/headline.astro";
import type { Hero } from "@/content/types";

interface Props {
  value: Hero;
}

const { value } = Astro.props;
---

<section class="container-page grid items-center gap-16 pt-16 pb-24 sm:pt-16 sm:pb-32 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
  <div>
    <h1 class="rise display max-w-3xl text-[2.6rem] leading-[1.05] sm:text-[4.25rem] sm:leading-[1.02]"><Headline text={value.headline} /></h1>
    {value.subheadline && (
      <p class="rise mt-8 max-w-[34rem] text-lg leading-relaxed text-muted-foreground [animation-delay:80ms]">{value.subheadline}</p>
    )}
    {(value.primary || value.secondary) && (
      <div class="rise mt-10 flex flex-wrap items-center gap-3 [animation-delay:160ms]">
        {value.primary && (
          <ButtonLink href={value.primary.href} size="hero">{value.primary.label}</ButtonLink>
        )}
        {value.secondary && (
          <ButtonLink href={value.secondary.href} size="hero" variant="outline">{value.secondary.label}</ButtonLink>
        )}
      </div>
    )}
  </div>
  {value.example && <ExampleSite value={value.example} class="rise [animation-delay:240ms]" />}
</section>
