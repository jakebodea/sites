---
/**
 * The three promises under the hero. Each panel carries a small illustration of
 * the promise (an editor publishing a change, a week of visits); both are
 * examples, labelled as such, not a client's real data.
 */
import { Check } from "@lucide/astro";

import Headline from "@/components/headline.astro";
import type { Pillars } from "@/content/types";

interface Props {
  value: Pillars;
}

const { value } = Astro.props;
// An illustrative week of visits, Monday to Sunday, as bar heights in percent.
const week = [38, 52, 47, 64, 71, 58, 86];
const days = ["M", "T", "W", "T", "F", "S", "S"];
---

<section class="container-page grid gap-4 pb-20 sm:pb-28 lg:grid-cols-[1fr_1.2fr]">
  <article class="flex flex-col justify-between gap-16 rounded-3xl bg-panel p-8 text-panel-foreground sm:p-12 lg:row-span-2">
    <h2 class="display text-5xl leading-[1.02] text-panel-foreground sm:text-7xl"><Headline text={value.speed.title} /></h2>
    <p class="max-w-md text-lg leading-relaxed text-panel-foreground/70">{value.speed.body}</p>
  </article>

  <article class="grid gap-8 rounded-3xl bg-muted p-8 sm:grid-cols-[1fr_1.05fr] sm:items-center sm:p-10 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <h2 class="display text-3xl leading-[1.08] sm:text-4xl"><Headline text={value.editing.title} /></h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">{value.editing.body}</p>
    </div>
    <figure class="rounded-2xl border border-border bg-card p-4 shadow-[0_1px_2px_oklch(0.2_0.02_265/0.04),0_16px_32px_-20px_oklch(0.2_0.02_265/0.18)]" aria-label="Example: editing opening hours">
      <p class="text-xs font-medium text-muted-foreground">Opening hours</p>
      <p class="mt-2 rounded-xl border border-input px-3 py-2 text-sm">Mon to Sat, 8am to 6pm<span class="ml-px inline-block h-4 w-px translate-y-0.5 animate-pulse bg-signal" aria-hidden="true"></span></p>
      <div class="mt-3 flex items-center justify-between gap-3">
        <span class="flex items-center gap-1.5 text-xs text-muted-foreground"><Check class="size-3.5 text-signal" stroke-width={2.5} aria-hidden="true" />Saved</span>
        <span class="rounded-full bg-ink px-3.5 py-1.5 text-xs font-medium text-background">Publish</span>
      </div>
    </figure>
  </article>

  <article class="grid gap-8 rounded-3xl bg-muted p-8 sm:grid-cols-[1fr_1.05fr] sm:items-center sm:p-10 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <h2 class="display text-3xl leading-[1.08] sm:text-4xl"><Headline text={value.analytics.title} /></h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">{value.analytics.body}</p>
    </div>
    <figure class="rounded-2xl border border-border bg-card p-4 shadow-[0_1px_2px_oklch(0.2_0.02_265/0.04),0_16px_32px_-20px_oklch(0.2_0.02_265/0.18)]" aria-label="Example: a week of visits">
      <div class="flex items-baseline justify-between gap-3">
        <p class="text-xs font-medium text-muted-foreground">Visitors this week</p>
        <p class="text-xs text-muted-foreground">Example</p>
      </div>
      <div class="mt-4 flex h-24 items-end gap-2" aria-hidden="true">
        {week.map((height, index) => (
          <div class="flex h-full flex-1 flex-col items-center justify-end gap-1.5">
            <span class:list={["w-full rounded-md", index === week.length - 1 ? "bg-signal" : "bg-input"]} style={`height: ${height}%`}></span>
            <span class="text-[0.65rem] text-muted-foreground">{days[index]}</span>
          </div>
        ))}
      </div>
    </figure>
  </article>
</section>
