---
import Headline from "@/components/headline.astro";
import type { ListSection } from "@/content/types";

interface Props {
  value: ListSection;
}

const { value } = Astro.props;
---

<!-- `id` is the hero's default "How I work" anchor (#process). -->
<section id="process" class="bg-muted py-20 sm:py-28">
  <div class="container-page">
    <h2 class="display max-w-2xl text-4xl leading-[1.08] sm:text-5xl"><Headline text={value.headline} /></h2>
    <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {value.items.map((step, index) => (
        <li class="relative">
          <div class="flex items-center gap-3" aria-hidden="true">
            <span class:list={["size-2.5 shrink-0 rounded-full ring-4 ring-muted", index === value.items.length - 1 ? "bg-signal" : "bg-ink"]}></span>
            <span class="hidden h-px flex-1 bg-input lg:block"></span>
          </div>
          <h3 class="mt-6 text-lg font-medium tracking-[-0.015em]">{step.title}</h3>
          <p class="mt-2 max-w-xs leading-relaxed text-muted-foreground">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
