---
import Headline from "@/components/headline.astro";
import SectionLabel from "@/components/section-label.astro";
import type { Statement } from "@/content/types";

interface Props {
  value: Statement;
}

const { value } = Astro.props;
---

<section class="container-page py-20 sm:py-28">
  <div class="rounded-3xl bg-secondary px-7 py-14 sm:px-16 sm:py-20">
    {value.label && <SectionLabel label={value.label} />}
    <p class="mt-8 max-w-3xl text-2xl leading-snug sm:text-4xl sm:leading-[1.2]"><Headline text={value.headline} /></p>
    {value.body && <p class="mt-6 max-w-xl leading-relaxed text-muted-foreground sm:text-lg">{value.body}</p>}
    {value.link && (
      <a href={value.link.href} class="mt-10 inline-flex items-center gap-2 text-[0.95rem] underline decoration-border underline-offset-[6px] transition-colors hover:decoration-foreground">
        {value.link.label}<span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>
</section>
