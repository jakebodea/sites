---
import Headline from "@/components/headline.astro";
import type { ListSection } from "@/content/types";

interface Props {
  value: ListSection;
}

const { value } = Astro.props;
---

<section id="work" class="container-page py-20 sm:py-28">
  <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end md:gap-16">
    <h2 class="display text-4xl leading-[1.08] sm:text-5xl"><Headline text={value.headline} /></h2>
    {value.intro && <p class="max-w-md text-lg leading-relaxed text-muted-foreground md:justify-self-end">{value.intro}</p>}
  </div>
  <dl class="mt-14 grid border-t border-border sm:grid-cols-2">
    {value.items.map((item) => (
      <div class="border-b border-border py-8 sm:odd:border-r sm:odd:pr-10 sm:even:pl-10">
        <dt class="text-lg font-medium tracking-[-0.015em]">{item.title}</dt>
        <dd class="mt-2 max-w-md leading-relaxed text-muted-foreground">{item.body}</dd>
      </div>
    ))}
  </dl>
</section>
