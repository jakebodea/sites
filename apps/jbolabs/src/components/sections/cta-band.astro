---
import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import type { CallToAction } from "@/content/types";

interface Props {
  value: CallToAction;
}

const { value } = Astro.props;
---

<section class="container-page py-12 sm:py-16">
  <div class="rounded-3xl bg-panel px-7 py-16 text-center text-panel-foreground sm:px-16 sm:py-24">
    <h2 class="display mx-auto max-w-3xl text-4xl leading-[1.06] text-panel-foreground sm:text-6xl"><Headline text={value.headline} /></h2>
    {value.body && <p class="mx-auto mt-6 max-w-lg text-lg leading-relaxed text-panel-foreground/65">{value.body}</p>}
    {value.link && (
      <ButtonLink href={value.link.href} size="hero" variant="inverse" class="mt-10">{value.link.label}</ButtonLink>
    )}
  </div>
</section>
