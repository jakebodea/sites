---
/**
 * WebSite and ProfessionalService JSON-LD on every page: the site, the
 * studio, and its founder. Unknown facts are omitted
 * rather than guessed (see site.config.ts).
 */
import { site } from "../../site.config";

interface Props {
  origin: string;
}

const { origin } = Astro.props;
const { business } = site;
interface StudioJsonLd {
  readonly "@context": string;
  readonly "@type": string;
  readonly description: string;
  readonly founder: { "@type": string; name: string };
  readonly image: string;
  readonly name: string;
  readonly url: string;
  email?: string;
}

const data: StudioJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  description: site.description,
  founder: { "@type": "Person", name: business.founder },
  image: `${origin}/og-default.png?v=20261006`,
  name: site.name,
  url: origin,
};
if (business.email !== undefined) {
  data.email = business.email;
}
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: origin,
};
---

<script type="application/ld+json" set:html={JSON.stringify(website)} />
<script type="application/ld+json" set:html={JSON.stringify(data)} />
