    "home": [
      {
        "id": "page-home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "Home",
          "content": [
            {
              "_type": "hero",
              "_version": 1,
              "_key": "hero",
              "availability": "Taking on new projects",
              "headline": "Websites and software, *made with care.*",
              "subheadline": "JBO Labs is the independent studio of Jake Bodea. I design, build, and look after websites and web apps for small teams who want them done properly.",
              "primary_cta_label": "Start a project",
              "primary_cta_url": "/contact",
              "secondary_cta_label": "How I work",
              "secondary_cta_url": "#process"
            },
            {
              "_type": "services",
              "_version": 1,
              "_key": "services",
              "label": "What I do",
              "headline": "One person, *start to finish.*",
              "intro": "You work directly with the person building your project. No hand-offs, no account managers.",
              "items": [
                {
                  "title": "Marketing websites",
                  "body": "Fast, accessible sites you can edit yourself, with search, analytics, and hosting taken care of."
                },
                {
                  "title": "Web apps and tools",
                  "body": "Customer portals, booking flows, dashboards, and the small internal tools that quietly remove busywork."
                },
                {
                  "title": "Technical consulting",
                  "body": "A second opinion on your stack, an audit of what you have, or a clear plan before you hire."
                },
                {
                  "title": "Care and hosting",
                  "body": "Updates, monitoring, and backups, plus a real person to call when something needs to change."
                }
              ]
            },
            {
              "_type": "process",
              "_version": 1,
              "_key": "process",
              "label": "How it works",
              "headline": "A simple, *unhurried* process.",
              "steps": [
                {
                  "title": "Intro call",
                  "body": "A short conversation about your goals, constraints, and whether I am the right fit."
                },
                {
                  "title": "Proposal",
                  "body": "A clear scope, timeline, and fixed price, so you know the cost before work begins."
                },
                {
                  "title": "Build",
                  "body": "Work happens in small, visible steps, with a live preview link you can check any time."
                },
                {
                  "title": "Launch and care",
                  "body": "We launch together, and I stay on hand for changes, questions, and support."
                }
              ]
            },
            {
              "_type": "statement",
              "_version": 1,
              "_key": "referred",
              "label": "Referred here?",
              "headline": "Most of my work comes from people I have *already worked with.*",
              "body": "If someone sent you my way, mention their name in the form. I like to thank the people who make introductions.",
              "link_label": "Start a project",
              "link_url": "/contact"
            },
            {
              "_type": "faq",
              "_version": 1,
              "_key": "faq",
              "label": "Questions",
              "headline": "Good to *know.*",
              "items": [
                {
                  "question": "What does a project cost?",
                  "answer": "Every project gets a fixed quote after the intro call, based on scope. The intake form asks for a rough budget so I can suggest what fits."
                },
                {
                  "question": "How long does it take?",
                  "answer": "Most websites take a few weeks from kickoff to launch. Larger apps are planned in phases, so something useful ships early."
                },
                {
                  "question": "Can I update the site myself?",
                  "answer": "Yes. Sites come with a simple editor for pages and content, and I will walk you through it."
                },
                {
                  "question": "Do you work remotely?",
                  "answer": "Yes. I work with clients anywhere, over video calls and a shared preview link."
                }
              ]
            },
            {
              "_type": "cta_band",
              "_version": 1,
              "_key": "cta",
              "headline": "Have something *in mind?*",
              "body": "Tell me a little about it. I read every message and reply personally.",
              "cta_label": "Start a project",
              "cta_url": "/contact"
            }
          ]
        }
      }
    ],
    "pages": [
      {
        "id": "page-about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About",
          "intro": "A small studio with a simple idea: do fewer projects, and do them very well.",
          "content": [
            {
              "_type": "rich_text",
              "_version": 1,
              "_key": "bio",
              "body": [
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p0",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p0s",
                      "text": "Hi, I am Jake. I run JBO Labs, a one-person studio that builds websites and web software for small businesses, founders, and teams."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p1",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p1s",
                      "text": "I care about the details most people never notice: pages that load instantly, forms that work on the first try, and sites that are easy for you to keep up to date long after launch."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p2",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p2s",
                      "text": "Before starting the studio, I spent years building software professionally. Now I work with a small number of clients at a time, so every project gets my full attention."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "h2",
                  "_key": "h0",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "h0s",
                      "text": "How I like to work"
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p3",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p3s",
                      "text": "Plain language, fixed prices, and no surprises. You always know what is being built, what it costs, and when it will be done."
                    }
                  ]
                }
              ]
            },
            {
              "_type": "cta_band",
              "_version": 1,
              "_key": "cta",
              "headline": "Let's build something *good.*",
              "cta_label": "Start a project",
              "cta_url": "/contact"
            }
          ]
        }
      },
      {
        "id": "page-contact",
        "slug": "contact",
        "status": "published",
        "data": {
          "title": "Start a project",
          "intro": "Tell me about what you are building. A few details now make our first conversation far more useful.",
          "content": []
        }
      },
      {
        "id": "page-privacy",
        "slug": "privacy",
        "status": "published",
        "data": {
          "title": "Privacy",
          "intro": "How this site handles analytics and the information you send.",
          "content": [
            {
              "_type": "rich_text",
              "_version": 1,
              "_key": "privacy",
              "body": [
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p0",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p0s",
                      "text": "This site uses anonymous, cookieless analytics to understand which pages are useful. It does not set cookies, store identifiers in your browser, or build a profile of you."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p1",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p1s",
                      "text": "When you send the intake form, I store what you enter (your name, email, company, website, project details, budget, timeline, and who referred you) so I can reply. I do not sell or share this information."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p2",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p2s",
                      "text": "The form is protected by Cloudflare Turnstile, which checks that a person, not a bot, is submitting it."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p3",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "p3s",
                      "text": "To ask about or delete information you have sent, use the intake form and mention this page."
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
