---
import Logo from "@/components/brand/logo.astro";

interface Props {
  title: string;
  intro?: string | undefined;
  eyebrow?: string | undefined;
}

const { eyebrow, intro, title } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <Logo variant="mark" play="load" class="pointer-events-none absolute top-1/2 -right-10 hidden h-[130%] w-auto -translate-y-1/2 opacity-[0.07] lg:block" />
  <div class="container-page relative pt-20 pb-16 sm:pt-28 sm:pb-24">
    <slot name="before" />
    {eyebrow && <p class="eyebrow page-rise mb-7" style="--d: 0.1s">{eyebrow}</p>}
    <h1 class="page-rise max-w-4xl text-5xl leading-[1.02] sm:text-6xl lg:text-[5.5rem]" style="--d: 0.2s">{title}</h1>
    {intro && <p class="page-rise mt-7 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl" style="--d: 0.35s">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-rise {
    animation: page-rise 1.2s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes page-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-rise {
      animation: none;
    }
  }
</style>
