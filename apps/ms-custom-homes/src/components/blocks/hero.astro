---
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import Logo from "@/components/brand/logo.astro";
import ButtonLink from "@/components/button-link.astro";
import type { PageContentHeroBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentHeroBlock>;

const { value } = Astro.props;
const slides = value.slides.flatMap((slide) => (slide.image ? [slide.image] : []));
const primary =
  value.primary_cta_label && value.primary_cta_url
    ? { href: sanitizeHref(value.primary_cta_url), label: value.primary_cta_label }
    : undefined;
const secondary =
  value.secondary_cta_label && value.secondary_cta_url
    ? { href: sanitizeHref(value.secondary_cta_url), label: value.secondary_cta_label }
    : undefined;

/*
 * CSS-only slideshow: each slide holds for 7 s, crossfades over 1.4 s, and pushes in
 * slowly while visible. One keyframe set per slide count, so the timing is exact.
 */
const holdSeconds = 7;
const cycle = slides.length * holdSeconds;
const fade = (1.4 / cycle) * 100;
const visible = (holdSeconds / cycle) * 100;
const pct = (percent: number) => `${percent.toFixed(2)}%`;
const keyframes =
  slides.length > 1
    ? `@keyframes hero-fade-${slides.length}{0%{opacity:0;transform:scale(1.1)}${pct(fade)}{opacity:1}${pct(visible)}{opacity:1}${pct(visible + fade)}{opacity:0;transform:scale(1)}100%{opacity:0;transform:scale(1)}}`
    : "";
const words = value.headline.split(" ");
---

<section class="hero relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-midnight text-white">
  {keyframes && <style set:html={keyframes} />}
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    {slides.map((image, index) => (
      <div
        class="hero-slide hero-slide-image absolute inset-0"
        style={slides.length > 1 ? `animation: hero-fade-${slides.length} ${cycle}s linear infinite; animation-delay: ${index * holdSeconds - 1.4}s;` : undefined}
      >
        <Image image={image} alt="" priority={index === 0} sizes="100vw" class="size-full! object-cover" />
      </div>
    ))}
  </div>
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-midnight/70 via-midnight/25 to-midnight/85" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_30%_60%,transparent_20%,rgb(15_22_30/0.45)_100%)]" aria-hidden="true"></div>

  <div class="container-page flex flex-1 flex-col justify-end pt-36 pb-16 sm:pb-20 lg:justify-center lg:pt-40 lg:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-3xl">
        {value.eyebrow && <p class="hero-rise label-caps mb-7 text-mist" style="--d: 0.4s">{value.eyebrow}</p>}
        <h1 class="text-[3.1rem] leading-[0.98] font-normal text-white sm:text-7xl lg:text-[6.5rem]">
          {words.map((word, index) => (
            <>
              <span class="hero-word inline-block overflow-hidden pb-[0.12em] align-bottom">
                <span class="inline-block" style={`--d: ${(0.55 + index * 0.09).toFixed(2)}s`}>{word}</span>
              </span>{" "}
            </>
          ))}
        </h1>
        {value.subheadline && (
          <p class="hero-rise mt-7 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl" style="--d: 1.1s">{value.subheadline}</p>
        )}
        {(primary || secondary) && (
          <div class="hero-rise mt-10 flex flex-col gap-3 sm:flex-row" style="--d: 1.3s">
            {primary && <ButtonLink href={primary.href} variant="inverse" size="hero">{primary.label}</ButtonLink>}
            {secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="hero">{secondary.label}</ButtonLink>}
          </div>
        )}
      </div>
      <Logo variant="mark" tone="white" play="load" class="hidden h-80 w-auto opacity-90 drop-shadow-[0_10px_40px_rgb(0_0_0/0.25)] lg:block xl:h-96" />
    </div>
  </div>

  <a href="#content-start" class="hero-rise group absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-white/70 sm:flex" style="--d: 2.2s" aria-label="Scroll to content">
    <span class="label-caps text-[0.62rem]">Scroll</span>
    <span class="scroll-line block h-12 w-px overflow-hidden bg-white/20"><span class="block h-full w-full bg-white"></span></span>
  </a>
</section>
<div id="content-start"></div>

<style>
  .hero-word > span,
  .hero-rise {
    animation: hero-rise 1.3s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  .hero-word > span {
    animation-name: hero-word;
  }

  .scroll-line > span {
    animation: scroll-line 2.4s var(--ease-in-out-quint) 2.8s infinite;
    transform: translateY(-100%);
  }

  @keyframes hero-word {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }

    50% {
      transform: translateY(0);
    }

    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word > span,
    .hero-rise,
    .scroll-line > span {
      animation: none;
    }

    .scroll-line > span {
      transform: none;
    }
  }
</style>
