---
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import Logo from "@/components/brand/logo.astro";
import ButtonLink from "@/components/button-link.astro";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-midnight">
  {value.image && (
    <div class="absolute inset-0 -z-10" data-reveal="fade">
      <Image image={value.image} alt="" sizes="100vw" class="size-full! object-cover" />
    </div>
  )}
  <div class="absolute inset-0 -z-10 bg-midnight/72" aria-hidden="true"></div>
  <div class="container-page flex flex-col items-center py-28 text-center sm:py-40">
    <Logo variant="mark" tone="white" play="scroll" class="mb-10 h-20 w-auto opacity-90" />
    {value.eyebrow && <p class="label-caps mb-6 text-mist" data-reveal>{value.eyebrow}</p>}
    <h2 class="max-w-3xl text-5xl text-white sm:text-6xl lg:text-7xl" data-reveal style="--reveal-delay: 80ms">{value.headline}</h2>
    {value.body && <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80" data-reveal style="--reveal-delay: 160ms">{value.body}</p>}
    {value.cta_label && value.cta_url && (
      <div data-reveal style="--reveal-delay: 240ms">
        <ButtonLink href={sanitizeHref(value.cta_url)} variant="inverse" size="hero" class="mt-10">{value.cta_label}</ButtonLink>
      </div>
    )}
  </div>
</section>
