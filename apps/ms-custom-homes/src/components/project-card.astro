---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { Image } from "emdash/ui";

import type { Project } from "@/lib/content";
import { PROJECT_TYPES } from "@/lib/content";

interface Props {
  slug: string;
  project: Project;
  /** Tailwind aspect classes for the photo (grids vary them for rhythm). */
  aspect?: string | undefined;
  /** Headline level inside the surrounding section. */
  headingLevel?: "h2" | "h3";
}

const { aspect = "aspect-[4/3]", headingLevel: Heading = "h3", project, slug } = Astro.props;
const inProgress = project.progress === "in_progress";
---

<article class="group relative flex w-full flex-col">
  <div class:list={["relative overflow-hidden bg-muted", aspect]} data-reveal="mask">
    {project.featured_image && (
      <div class="reveal-zoom size-full">
        <Image
          image={project.featured_image}
          alt={project.featured_image.alt ?? project.title}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="size-full! object-cover transition-transform duration-1600 ease-expo group-hover:scale-[1.04] motion-reduce:transition-none"
        />
      </div>
    )}
    <div class="absolute inset-0 bg-midnight/0 transition-colors duration-700 group-hover:bg-midnight/15" aria-hidden="true"></div>
    {inProgress && (
      <span class="label-caps absolute top-5 left-5 bg-ivory/95 px-3 py-2 text-[0.62rem] text-slate">Under construction</span>
    )}
    <span class="absolute right-5 bottom-5 flex size-12 translate-y-2 items-center justify-center bg-ivory text-slate opacity-0 transition-[opacity,transform] duration-500 group-hover:translate-y-0 group-hover:opacity-100" aria-hidden="true">
      <ArrowUpRight class="size-5" />
    </span>
  </div>
  <div class="mt-6 flex items-start justify-between gap-6" data-reveal style="--reveal-delay: 150ms">
    <div>
      <p class="label-caps text-[0.64rem] text-brand">{PROJECT_TYPES[project.project_type]}{project.location ? ` · ${project.location}` : ""}</p>
      <Heading class="mt-2 text-2xl sm:text-3xl">
        <a href={`/projects/${slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">{project.title}</a>
      </Heading>
    </div>
  </div>
</article>
