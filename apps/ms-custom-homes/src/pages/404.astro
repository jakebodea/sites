---
import Logo from "@/components/brand/logo.astro";
import ButtonLink from "@/components/button-link.astro";
import Base from "@/layouts/base.astro";

Astro.response.status = 404;
---

<Base title="Page not found" robots="noindex">
  <section class="container-page flex min-h-[70svh] flex-col items-center justify-center gap-7 py-24 text-center">
    <Logo variant="mark" play="load" class="h-28 w-auto" />
    <p class="eyebrow">404</p>
    <h1 class="text-5xl sm:text-6xl">This room hasn't been built yet.</h1>
    <p class="max-w-xl text-lg text-muted-foreground">The page may have moved. The portfolio and contact pages are good places to start.</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <ButtonLink href="/portfolio" size="cta">View the portfolio</ButtonLink>
      <ButtonLink href="/contact" size="cta" variant="hairline">Contact us</ButtonLink>
    </div>
  </section>
</Base>
