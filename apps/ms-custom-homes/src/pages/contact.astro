---
import { env } from "cloudflare:workers";
import { getSeoMeta } from "emdash";

import PageBlocks from "@/components/blocks/page-blocks.astro";
import ContactForm from "@/components/islands/contact-form";
import PageHeader from "@/components/page-header.astro";
import Base from "@/layouts/base.astro";
import { getPage } from "@/lib/content";
import { site } from "../../site.config";

const { cacheHint, entry: page } = await getPage("contact");
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
const title = page?.data.title ?? "Contact us";
const seo = page ? getSeoMeta(page, { defaultDescription: page.data.intro, path: "/contact", siteUrl: Astro.url.origin }) : undefined;
const { address, email, license, telephone } = site.business;
---

<Base
  title={seo?.title ?? title}
  description={seo?.description}
  image={seo?.ogImage}
  robots={seo?.robots}
  content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
  <PageHeader title={title} intro={page?.data.intro} eyebrow="Contact" />
  <section class="container-page grid gap-16 py-20 sm:py-28 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-24">
    <ContactForm client:visible turnstileSiteKey={env.TURNSTILE_SITE_KEY} />
    <aside class="space-y-12">
      <div>
        <p class="eyebrow mb-5 flex!">Call</p>
        <a href={`tel:${telephone}`} class="font-display text-4xl text-slate lining-nums transition-colors hover:text-brand">{site.phone}</a>
      </div>
      {email && (
        <div>
          <p class="eyebrow mb-5 flex!">Email</p>
          <a href={`mailto:${email}`} class="text-lg break-all text-slate underline decoration-champagne underline-offset-4">{email}</a>
        </div>
      )}
      <div>
        <p class="eyebrow mb-5 flex!">Office</p>
        <address class="text-lg leading-relaxed text-slate not-italic">{address.street}<br />{address.city}, {address.region} {address.postalCode}</address>
        <p class="mt-3 text-sm text-muted-foreground">Monday to Friday, by appointment.</p>
      </div>
      <p class="border-t border-border pt-8 text-sm leading-relaxed text-muted-foreground">
        {license}. Your details are used only to reply to you. See our <a href="/privacy" class="text-slate underline underline-offset-4">privacy notes</a>.
      </p>
    </aside>
  </section>
  {page && <div {...page.edit.content}><PageBlocks value={page.data.content} /></div>}
</Base>
