        "data": {
          "title": "About",
          "intro": "A woman-owned custom home builder with nearly thirty years in construction.",
          "content": [
            {
              "_type": "story",
              "_version": 1,
              "_key": "story",
              "eyebrow": "Our story",
              "headline": "Built on experience, run with heart.",
              "body": [
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p0",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s0",
                      "text": "Mia Marcantonio has been in the construction industry for close to 30 years. She started at a top structural engineering firm in Pasadena, where the work was hospitals and schools, then moved to an architecture firm in Newport Beach in the same field."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p1",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s1",
                      "text": "After seven years she made the switch to residential construction, working for two of the largest custom home builders in Orange County. There she honed her skills in custom residential design and building."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p2",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s2",
                      "text": "With what she learned from her mentors, she founded MS Custom Homes as a woman-owned business. Her approach is different: she cares about each client's wellbeing, and her goal on every project is the same: on budget and on time."
                    }
                  ]
                }
              ],
              "image": {
                "$media": {
