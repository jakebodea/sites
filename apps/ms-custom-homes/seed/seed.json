        "data": {
          "title": "Privacy",
          "intro": "How this site handles analytics and the information you send us.",
          "content": [
            {
              "_type": "rich_text",
              "_version": 1,
              "_key": "privacy",
              "body": [
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p0",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s0",
                      "text": "This site uses anonymous, cookieless analytics to understand which pages are useful. It does not set cookies, store identifiers in your browser, or build a profile of you. Page addresses are recorded without query strings, except campaign tags such as utm_source."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p1",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s1",
                      "text": "When you send the contact form, we store your name, email, phone, and message so we can reply. We do not sell or share this information, and it is used only to respond to you."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p2",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s2",
                      "text": "The contact form is protected by Cloudflare Turnstile, which checks that a person, not a bot, is submitting it."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p3",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s3",
                      "text": "Links to our financing partner take you to E Mortgage Capital's website, which has its own privacy policy."
                    }
                  ]
                },
                {
                  "_type": "block",
                  "style": "normal",
                  "_key": "p4",
                  "children": [
                    {
                      "_type": "span",
                      "_key": "s4",
                      "text": "To ask about or delete information you have sent us, use the contact form and mention this page."
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
