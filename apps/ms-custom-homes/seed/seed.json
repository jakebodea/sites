        "data": {
          "title": "Home",
          "content": [
            {
              "_type": "hero",
              "_version": 1,
              "_key": "hero",
              "eyebrow": "Custom homes · Remodels · Orange County",
              "headline": "Homes built with intention.",
              "subheadline": "A woman-owned builder creating custom homes and thoughtful remodels, delivered on budget and on time.",
              "slides": [
                {
                  "image": {
                    "$media": {
                      "url": "/_seed/media/farmhouse-stair-dining.jpg",
                      "alt": "Open staircase and dining room in a custom home",
