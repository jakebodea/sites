---
import MapPin from "@lucide/astro/icons/map-pin";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentServiceAreaBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentServiceAreaBlock>;

const { value } = Astro.props;
const areas = value.areas.split("\n").map((area) => area.trim()).filter((area) => area !== "");
---

<section class="container-page py-14 sm:py-20">
  <div class="grid gap-8 rounded-xl border border-border bg-card p-7 sm:p-10 md:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 class="text-2xl sm:text-3xl">{value.headline}</h2>
      {value.body && <p class="mt-3 leading-relaxed text-muted-foreground">{value.body}</p>}
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {areas.map((area) => (
        <li class="flex items-center gap-3 rounded-lg bg-secondary/70 px-4 py-3 text-sm font-medium">
          <MapPin class="size-4 shrink-0 text-navy" aria-hidden="true" />{area}
        </li>
      ))}
    </ul>
  </div>
</section>
