---
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentFactsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentFactsBlock>;

const { value } = Astro.props;
---

<section class="border-y border-border bg-navy text-white">
  <dl class="container-page grid grid-cols-2 gap-y-8 py-12 lg:grid-cols-4">
    {value.items.map((item) => (
      <div class="flex flex-col border-l-2 border-olive pr-4 pl-5">
        <dt class="text-sm leading-snug text-white/75">{item.label}</dt>
        <dd class="order-first font-display text-3xl font-bold sm:text-4xl">{item.value}</dd>
      </div>
    ))}
  </dl>
</section>
