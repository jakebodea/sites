---
import type { NavItem } from "@/lib/content";
import MobileNav from "./islands/mobile-nav";
import ButtonLink from "./button-link.astro";

interface Props {
  title: string;
  items: readonly NavItem[];
}

const { items, title } = Astro.props;
const current = Astro.url.pathname;
const isActive = (url: string) =>
  url === "/" ? current === "/" : current === url || current.startsWith(`${url}/`);
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/80">
  <div class="container-page flex h-16 items-center justify-between gap-6 sm:h-20">
    <a href="/" class="flex shrink-0 items-center rounded-sm" aria-label={`${title}, home`}>
      <img src="/brand/logo.webp" alt={title} width="339" height="100" class="h-9 w-auto sm:h-11" />
    </a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={item.url}
            aria-current={isActive(item.url) ? "page" : undefined}
            class="rounded-md px-3 py-2 text-sm font-medium text-foreground/75 hover:bg-muted hover:text-foreground aria-[current=page]:text-navy aria-[current=page]:underline aria-[current=page]:decoration-olive aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
          >
            {item.label}
          </a>
        ))
      }
      <ButtonLink href="/contact" size="cta" class="ml-3">Request a bid</ButtonLink>
    </nav>
    <MobileNav client:media="(max-width: 767px)" title={title} items={[...items]} currentPath={current} />
  </div>
</header>
