---
import { Image } from "emdash/ui";

import type { Project } from "@/lib/content";

interface Props {
  slug: string;
  project: Project;
  /** Headline level inside the surrounding section. */
  headingLevel?: "h2" | "h3";
}

const { headingLevel: Heading = "h3", project, slug } = Astro.props;
const inProgress = project.progress === "in_progress";
---

<article class="group relative flex w-full flex-col overflow-hidden rounded-xl border border-border bg-card shadow-xs hover:shadow-md">
  <div class="relative aspect-[4/3] overflow-hidden bg-muted">
    {project.featured_image && (
      <Image
        image={project.featured_image}
        alt={project.featured_image.alt ?? project.title}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        class="size-full! object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
      />
    )}
    {inProgress && (
      <span class="absolute top-3 left-3 rounded-full bg-olive px-2.5 py-1 text-xs font-semibold text-navy-deep">Under construction</span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-5">
    <Heading class="text-lg leading-snug">
      <a href={`/projects/${slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">{project.title}</a>
    </Heading>
    {project.location && <p class="text-sm text-muted-foreground">{project.location}</p>}
  </div>
</article>
