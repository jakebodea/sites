---
/**
 * LocalBusiness (Electrician) JSON-LD on every page. EmDashHead adds the
 * WebSite graph; this adds the business itself. Unknown facts are omitted
 * rather than guessed (see site.config.ts).
 */
import { site } from "../../site.config";

interface Props {
  origin: string;
}

const { origin } = Astro.props;
const { business } = site;
interface ElectricianJsonLd {
  readonly "@context": string;
  readonly "@type": string;
  readonly areaServed: readonly { "@type": string; name: string }[];
  readonly description: string;
  readonly foundingDate: string;
  readonly image: string;
  readonly logo: string;
  readonly name: string;
  readonly url: string;
  email?: string;
  telephone?: string;
}

const data: ElectricianJsonLd = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  areaServed: business.areaServed.map((name) => ({
    "@type": "AdministrativeArea",
    name,
  })),
  description: site.description,
  foundingDate: String(business.foundingYear),
  image: `${origin}/og-default.png`,
  logo: `${origin}/brand/logo.png`,
  name: site.name,
  url: origin,
};
if (business.email !== undefined) {
  data.email = business.email;
}
if (business.telephone !== undefined) {
  data.telephone = business.telephone;
}
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
