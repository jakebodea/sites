---
interface Props {
  title: string;
  intro?: string | undefined;
  eyebrow?: string | undefined;
}

const { eyebrow, intro, title } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border bg-secondary/60">
  <div class="absolute inset-y-0 right-0 hidden w-1/3 bg-[repeating-linear-gradient(135deg,transparent_0_22px,color-mix(in_oklch,var(--brand-navy)_5%,transparent)_22px_23px)] lg:block" aria-hidden="true"></div>
  <div class="container-page relative py-12 sm:py-16 lg:py-20">
    <slot name="before" />
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="max-w-3xl text-4xl sm:text-5xl lg:text-6xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
