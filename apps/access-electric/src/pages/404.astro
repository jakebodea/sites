---
import ButtonLink from "@/components/button-link.astro";
import Base from "@/layouts/base.astro";

Astro.response.status = 404;
---

<Base title="Page not found" robots="noindex">
  <section class="container-page flex min-h-[55svh] flex-col items-start justify-center gap-5 py-20">
    <p class="eyebrow">404</p>
    <h1 class="text-4xl sm:text-5xl">We could not find that page.</h1>
    <p class="max-w-xl text-lg text-muted-foreground">It may have moved. Our portfolio and contact pages are good places to start.</p>
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/portfolio" size="cta">View the portfolio</ButtonLink>
      <ButtonLink href="/contact" size="cta" variant="outline">Contact us</ButtonLink>
    </div>
  </section>
</Base>
