{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 9am on monday"],
  "timezone": "America/Los_Angeles",
  "rangeStrategy": "pin",
  "packageRules": [
    { "groupName": "effect", "matchPackageNames": ["effect", "@effect/**"] },
    {
      "groupName": "alchemy",
      "matchPackageNames": ["alchemy", "@alchemy.run/**", "@distilled.cloud/**"]
    },
    {
      "groupName": "emdash",
      "matchPackageNames": ["emdash", "@emdash-cms/**"]
    },
    { "groupName": "astro", "matchPackageNames": ["astro", "@astrojs/**"] },
    {
      "groupName": "lint",
      "matchPackageNames": [
        "ultracite",
        "oxlint",
        "oxfmt",
        "oxlint-*",
        "eslint-plugin-sonarjs",
        "@shadcn/lint"
      ]
    },
    { "matchManagers": ["github-actions"], "groupName": "github actions" }
  ]
}
